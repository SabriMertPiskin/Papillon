*.pyc
*.pyo
*.egg-info/
venv/
.env

# --- Node ---
node_modules/
dist/
dist-ssr/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
__MACOSX/

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Misc ---
*.local
*.log
